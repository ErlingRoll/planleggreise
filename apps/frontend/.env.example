# Leave empty for local development so Vite proxies /api to the backend.
VITE_API_BASE_URL=

# Supabase browser configuration. The publishable key is safe to expose in
# browser code; never use a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
