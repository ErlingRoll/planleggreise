{
  "name": "turprep",
  "private": true,
  "version": "0.1.0",
  "description": "Turprep travel planning workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:models && concurrently -k \"npm run dev:models\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:models": "npm run dev --workspace @turprep/models",
    "dev:backend": "npm run dev --workspace @turprep/backend",
    "dev:frontend": "npm run dev --workspace @turprep/frontend",
    "build": "npm run build:models && npm run build:backend && npm run build:frontend",
    "build:models": "npm run build --workspace @turprep/models",
    "build:backend": "npm run build --workspace @turprep/backend",
    "build:frontend": "npm run build --workspace @turprep/frontend",
    "lint": "npm run lint --workspace @turprep/frontend",
    "test": "npm run build:models && npm run test:backend",
    "test:backend": "npm run test --workspace @turprep/backend",
    "start": "npm run start --workspace @turprep/backend",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
